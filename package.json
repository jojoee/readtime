{
  "name": "@jojoee/readtime",
  "version": "0.0.0-development",
  "description": "A lightweight reading-time estimator for plain text and HTML article fragments",
  "keywords": [
    "readtime",
    "reading-time",
    "reading",
    "article",
    "html"
  ],
  "homepage": "https://github.com/jojoee/readtime",
  "bugs": {
    "url": "https://github.com/jojoee/readtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jojoee/readtime.git"
  },
  "license": "MIT",
  "author": "Nathachai Thongniran <inid3a@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:umd && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/esm/index.js",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --outfile=dist/cjs/index.cjs",
    "build:umd": "esbuild src/index.ts --bundle --format=iife --global-name=readtime --outfile=dist/readtime.umd.js",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist/types",
    "lint": "ts-standard src/**/*.ts",
    "lint:fix": "ts-standard --fix src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "esbuild": "^0.19.8",
    "ts-standard": "^12.0.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
